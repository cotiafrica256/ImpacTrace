APP_NAME="ImpacTrace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Kampala
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mecpa_meal
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
